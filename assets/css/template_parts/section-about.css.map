/* stylelint-disable */
.about-section {
  padding: 16.65rem 0;
  position: relative;
  z-index: 1;
  margin-bottom: var(--default-padding);
}
.about-section__bg {
  position: absolute;
  z-index: -1;
  inset: 0;
  pointer-events: none;
}
.about-section__bg img, .about-section__bg picture, .about-section__bg svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
@media (max-width: 575px) {
  .about-section__bg img, .about-section__bg picture, .about-section__bg svg {
    object-position: 63% 50%;
  }
}
.about-section__box {
  display: flex;
  flex-direction: column;
  gap: 2.4rem;
}
.about-section__box .editor {
  max-width: 68rem;
  width: 100%;
  gap: 2.4rem;
}
@media (max-width: 575px) {
  .about-section__box .editor .h1 {
    padding-left: 16px;
  }
}
.about-section__box .editor p:not([class]) {
  font-size: 1.6rem;
  line-height: 150%;
  letter-spacing: 0.005em;
}
@media (max-width: 480px) {
  .about-section__box .editor p:not([class]) {
    max-width: 90%;
  }
}
.about-section__box .editor * {
  color: var(--cl-a);
}
@media (max-width: 991px) and (min-width: 767px) {
  .about-section {
    padding-top: 165px;
  }
}
@media (max-width: 766px) {
  .about-section {
    padding: 64px 0;
  }
}